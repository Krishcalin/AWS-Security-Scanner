# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Test / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# CNAPP persistent-state store (Phase 5)
.cnapp/
*.db
*.db-wal
*.db-shm
phase*_spec.json

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
# The air-gap wheelhouse: ~24MB of third-party wheels that
# scripts/build_offline_bundle.sh downloads on a CONNECTED build host (and
# rm -rf's on every run). Regenerable from requirements.txt, so it is a build
# artifact, not source. .dockerignore DELIBERATELY keeps it in the build
# context -- Docker reads that file, not this one -- so ignoring it here does
# not affect the image build.
wheelhouse/
overwatch-airgap-*.tar.gz

# Virtual environments
.venv/
venv/
env/

# Scanner output
*.json.report
reports/
evidence/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets (be very explicit)
.env
.env.*
!.env.example
credentials.json
*.pem

# Generated by scripts/coverage_gap.py -- a snapshot of the AWS service-coverage
# ranking. Regenerate with `python scripts/coverage_gap.py`; do not commit it, since
# nothing tests its currency and a stale ranking reads as a current one.
coverage_gap.json

# The raw _add recording behind docs/CHECK_FIRING.md, written by
# `OVERWATCH_RECORD_CHECKS=fired.json python -m pytest tests/ -q`. The generated doc
# is committed and tested for currency; this input is not, for the coverage_gap.json
# reason -- a recording from an older suite would read as a current measurement.
fired.json
